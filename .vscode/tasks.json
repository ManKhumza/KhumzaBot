{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Qwen Code: Open RunPod Terminal",
      "type": "shell",
      "command": "khumza-qwen",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Qwen Code: Stop RunPod GPU",
      "type": "shell",
      "command": "khumza-qwen-stop",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
