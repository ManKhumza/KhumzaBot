    "dist": "electron-builder --win --x64 --publish=never --config builder.yaml"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "43.7.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.63.0",
    "typescript": "^5.3.0"
  }
}
