{
  "name": "noc-ai-electron",
  "version": "1.1.0",
  "description": "Private local AI assistant for Windows",
  "author": "NOC AI",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc",
    "test:e2e": "playwright test --config playwright.config.cjs",
